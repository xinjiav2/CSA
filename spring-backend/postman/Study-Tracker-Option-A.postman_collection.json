{
  "info": {
    "name": "Study Tracker Option A",
    "description": "CRUD tests for the stateless Spring Boot StudyRecord API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8585/api/study-records" }],
  "item": [
    {
      "name": "Create study record",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"topic\": \"Unit 2: Using Objects\",\n  \"subtopic\": \"String methods\",\n  \"studentName\": \"Zhengji Li\",\n  \"status\": \"IN_PROGRESS\",\n  \"minutesStudied\": 35,\n  \"confidence\": 3,\n  \"notes\": \"Review substring indexes\"\n}" },
        "url": "{{baseUrl}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('recordId', pm.response.json().id);"] } }]
    },
    {
      "name": "Get all records",
      "request": { "method": "GET", "url": "{{baseUrl}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('OK', () => pm.response.to.have.status(200));", "pm.test('Array returned', () => pm.expect(pm.response.json()).to.be.an('array'));"] } }]
    },
    {
      "name": "Get one record",
      "request": { "method": "GET", "url": "{{baseUrl}}/{{recordId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('OK', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "Update record",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"topic\": \"Unit 2: Using Objects\",\n  \"subtopic\": \"String methods\",\n  \"studentName\": \"Zhengji Li\",\n  \"status\": \"COMPLETED\",\n  \"minutesStudied\": 55,\n  \"confidence\": 4,\n  \"notes\": \"Completed practice questions\"\n}" },
        "url": "{{baseUrl}}/{{recordId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Updated', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "Delete record",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/{{recordId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('No content', () => pm.response.to.have.status(204));"] } }]
    }
  ]
}
